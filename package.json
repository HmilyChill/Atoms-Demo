{
  "name": "atoms-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register.mjs --test --test-isolation=none \"tests/**/*.test.ts\"",
    "smoke": "node scripts/e2e-smoke.mjs",
    "smoke:provider": "node scripts/provider-smoke.mjs",
    "deploy:check": "node scripts/deploy-check.mjs",
    "push:github": "node scripts/push-to-github.mjs",
    "verify": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  }
}
