# ─────────────────────────────────────────────────────────────
# 复制为 .env.local 后填写（.env.local 已被 .gitignore 忽略）
# 生产环境请配置到平台的环境变量，Preview 与 Production 都要配
# ─────────────────────────────────────────────────────────────

# 必填：会话签名密钥（任意足够长的随机串）。不配置会退回开发默认值，公网部署务必配置。
AUTH_SECRET=please-change-me-to-a-long-random-string

# 可选：DeepSeek。不配置时自动运行在「确定性 Mock provider」模式（无 Key 也能完整演示）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_MS=60000

# 可选：配额与限流保护（公网部署强烈建议保留）
RUN_CALL_BUDGET=12
DAILY_CALL_LIMIT=300
RATE_LIMIT_PER_MINUTE=20
MAX_INPUT_LENGTH=4000

# 可选：强制演示模式（忽略已配置的 Key）
DEMO_MODE=false

# 可选：数据文件位置（默认 .data/atoms.db）
# ATOMS_DATA_DIR=.data
# ATOMS_DB_FILE=.data/atoms.db

# ─────────────────────────────────────────────────────────────
# 线上持久化（Vercel 等只读文件系统【必须】配置；本机无需配置）
#
# 配置 TURSO_DATABASE_URL 后，存储层会自动从本地 SQLite 文件切换到
# Turso（SQL over HTTP）执行器，**无需改任何代码**。
# 获取方式：turso db show <db> --http-url   /   turso db tokens create <db>
# 也接受 libsql:// 或 turso:// 前缀（会自动规范化为 https://）
# ─────────────────────────────────────────────────────────────
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# 远程请求超时（毫秒）
# DB_TIMEOUT_MS=20000

# 可选：仅用于本地测试，让 Mock provider 产生可观察的耗时
# MOCK_LATENCY_MS=120
